[Unit]
Description=家庭单词记忆服务
After=network.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
EnvironmentFile=/etc/remember-words.env
ExecStart="@ROOT@/.venv/bin/python" -m uvicorn backend.app.main:app --host 127.0.0.1 --port 18765 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths="@ROOT@/data"

[Install]
WantedBy=multi-user.target
